{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run --directory backend pytest)",
      "Bash(uv run --directory backend pytest *)",
      "Bash(uv run --directory backend ruff *)",
      "Bash(uv run --directory backend mypy *)",
      "Bash(uv run --directory backend alembic *)",
      "Bash(uv run --directory backend python -m app.scripts.exportar_openapi *)",
      "Bash(uv sync --directory backend)",
      "Bash(uv sync --directory backend *)",
      "Bash(npm --prefix frontend run *)",
      "Bash(npm --prefix frontend ci)",
      "Bash(npm --prefix frontend install)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./dados/**)",
      "Read(./backend/.venv/**)",
      "Read(./backend/uv.lock)",
      "Read(./backend/app/static/**)",
      "Read(./frontend/node_modules/**)",
      "Read(./frontend/package-lock.json)",
      "Read(./frontend/dist/**)",
      "Bash(git push *)",
      "Bash(rm -rf *)"
    ]
  }
}
