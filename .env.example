# Copie para .env (na raiz do repositório) no desenvolvimento.
# Todas as variáveis são opcionais; veja docs/06-arquitetura.md §6.

# Pasta de dados do desenvolvimento (caminho relativo = a partir da raiz do repositório)
FRENTES_DATA_DIR=dados

FRENTES_TIMEZONE=America/Sao_Paulo
FRENTES_PORT=8765
FRENTES_MAX_UPLOAD_MB=50
FRENTES_LIXEIRA_DIAS=30
FRENTES_ABRIR_NAVEGADOR=true

# Só para teste manual de avisos e virada de mês. Descomente com uma data AAAA-MM-DD.
# FRENTES_HOJE_SIMULADO=2026-10-31
